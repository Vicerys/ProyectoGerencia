@model  Gerencia.Presentacion.MVC.Models.ViewModels.Proyecto.ProyectoIndexViewModel
@using  Gerencia.Presentacion.MVC.Models.ViewModels.Proyecto
@{
    ViewData["Title"] = "Proyecto";
}

<div class="row g-3">
    <!-- Filtro -->
    <div class="col-12 col-xl-3">
        <div class="card">
            <div class="card-header">Filtro</div>
            <div class="card-body">
                <form method="get" class="vstack gap-3">
                    <input type="hidden" name="mode" value="filter" />

                    <div class="row g-2">
                        <div class="col-6">
                            <label asp-for="Filtro.ProyectoID" class="form-label"></label>
                            <input asp-for="Filtro.ProyectoID" class="form-control" />
                        </div>
                        <div class="col-6">
                            <label asp-for="Filtro.NombreLike" class="form-label"></label>
                            <input asp-for="Filtro.NombreLike" class="form-control" placeholder="Contiene…" />
                        </div>
                    </div>

                    <div>
                        <label class="form-label d-block">Rango de Fecha</label>
                        <div class="mb-2">
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" name="Filtro.FechaTarget" value="None"
                                       @(Model.Filtro.FechaTarget == DateTarget.None ? "checked" : null) />
                                <label class="form-check-label">Ninguna</label>
                            </div>
                   
                        </div>
                        <div class="row g-2">
                            <div class="col">
                                <label asp-for="Filtro.FechaDesde" class="form-label"></label>
                                <input asp-for="Filtro.FechaDesde" type="date" class="form-control" />
                            </div>
                            <div class="col">
                                <label asp-for="Filtro.FechaHasta" class="form-label"></label>
                                <input asp-for="Filtro.FechaHasta" type="date" class="form-control" />
                            </div>
                        </div>
                    </div>

      
                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary">Aplicar Filtro</button>
                    </div>
                </form>

                <form method="get" class="mt-2 d-grid">
                    <input type="hidden" name="mode" value="all" />
                    <button class="btn btn-outline-secondary">Mostrar todos</button>
                </form>

                <a class="btn btn-success mt-3 w-100" asp-action="Create">Crear</a>
            </div>
        </div>
    </div>

    <!-- Resultados -->
    <div class="col-12 col-xl-9">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span>Resultados (@Model.Resultados?.TotalCount ?? 0)</span>
            </div>
            <div class="card-body p-0">
                <form method="get" class="m-0 p-0">
                    <input type="hidden" name="mode" value="filter" />
                    <!-- Hiddens para conservar filtros al paginar -->
                    <input type="hidden" name="Filtro.ProductoID" value="@(Model.Filtro.ProyectoID)" />
                    <input type="hidden" name="Filtro.NombreLike" value="@(Model.Filtro.NombreLike)" />
                    <input type="hidden" name="Filtro.FechaTarget" value="@Model.Filtro.FechaTarget" />
                    <input type="hidden" name="Filtro.FechaDesde" value="@(Model.Filtro.FechaDesde?.ToString("yyyy-MM-dd"))" />
                    <input type="hidden" name="Filtro.FechaHasta" value="@(Model.Filtro.FechaHasta?.ToString("yyyy-MM-dd"))" />
                    
                    <table class="table table-striped table-hover mb-0">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Nombre</th>
                                <th>FechaLimite</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Resultados is not null)
                            {
                                foreach (var p in Model.Resultados)
                                {
                                    <tr>
                                        <td>@p.ProyectoId</td>
                                        <td>@p.Nombre</td>
                                        <td>@p.FechaLimite</td>
                                        <td class="text-nowrap">
                                            <a class="btn btn-sm btn-warning" asp-action="Edit" asp-route-id="@p.ProyectoId">Editar</a>
                                            <a class="btn btn-sm btn-danger" asp-action="Delete" asp-route-id="@p.ProyectoId">Borrar</a>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>

                    <div class="p-3">
                        @if (Model.Resultados is not null)
                        {
                            @await Html.PartialAsync("_Pagination", Model.Resultados)
                        }
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

