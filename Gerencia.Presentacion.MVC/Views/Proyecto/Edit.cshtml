@model Gerencia.Presentacion.MVC.Models.ViewModels.Proyecto.ProyectoFormViewModel
@{
    ViewData["Title"] = "Editar Proyecto";
}

<h1>Editar Proyecto</h1>

<form asp-action="Edit" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Proyecto.ProyectoId" />

    <div class="mb-3">
        <label class="form-label">ID</label>
        <input class="form-control" value="@Model.Proyecto.ProyectoId" disabled />
    </div>

    <partial name="_ProyectoFormBodyVM" model="Model" />

    <div class="mt-3 d-flex gap-2">
        <button type="submit" class="btn btn-primary">Guardar</button>
        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}


@{
}