@model Gerencia.Presentacion.MVC.Models.ViewModels.Proyecto.ProyectoIndexViewModel
@using Gerencia.Presentacion.MVC.Models.ViewModels.Proyecto
@{
    ViewData["Title"] = "Proyecto";
}

<style>
    body {
        background-color: #f4f6f9;
    }

    .section-card {
        border: none;
        border-radius: 8px;
    }

    .project-item {
        cursor: pointer;
        transition: background-color 0.15s ease-in-out;
    }

        .project-item:hover {
            background-color: #f1f3f5;
        }

        .project-item.active {
            background-color: #e7f1ff;
            border-left: 4px solid #0d6efd;
        }

    .crud-btn {
        height: 48px;
        font-weight: 500;
    }

    .process-title {
        font-weight: 600;
        font-size: 0.95rem;
        color: #495057;
        border-bottom: 1px solid #dee2e6;
        padding-bottom: 4px;
        margin-bottom: 8px;
    }

    .task-item {
        font-size: 0.9rem;
    }

    .task-completed {
        text-decoration: line-through;
        color: #6c757d;
    }
</style>

<div class="container-fluid py-4">
    <div class="row g-4">

        <!-- COLUMNA A -->
        <div class="col-lg-4">

            <!-- C: Proyectos -->
            <div class="card section-card shadow-sm mb-4">
                <div class="card-body">
                    <h6 class="fw-semibold mb-3">Proyectos asignados</h6>

                    <ul class="list-group" id="projectList">
                        @foreach (var proyecto in Model.Proyectos)
                        {
                            <li class="list-group-item project-item"
                                data-project-id="@proyecto.Id">
                                @proyecto.Nombre
                            </li>
                        }
                    </ul>
                </div>
            </div>

            <!-- D: CRUD -->
            <div class="card section-card shadow-sm">
                <div class="card-body">
                    <h6 class="fw-semibold mb-3">Gestión</h6>

                    <div class="row g-2">
                        <div class="col-6">
                            <button class="btn btn-outline-primary w-100 crud-btn">
                                Crear
                            </button>
                        </div>
                        <div class="col-6">
                            <button class="btn btn-outline-secondary w-100 crud-btn" id="readBtn" disabled>
                                Ver
                            </button>
                        </div>
                        <div class="col-6">
                            <button class="btn btn-outline-warning w-100 crud-btn" id="editBtn" disabled>
                                Editar
                            </button>
                        </div>
                        <div class="col-6">
                            <button class="btn btn-outline-danger w-100 crud-btn" id="deleteBtn" disabled>
                                Eliminar
                            </button>
                        </div>
                    </div>

                </div>
            </div>

        </div>

        <!-- COLUMNA B -->
        <div class="col-lg-8">
            <div class="card section-card shadow-sm">
                <div class="card-body">
                    <h6 class="fw-semibold mb-4">Tareas por proceso</h6>

                    @foreach (var proceso in Model.Procesos)
                    {
                        <div class="mb-4">
                            <div class="process-title">
                                @proceso.Nombre
                            </div>

                            @foreach (var tarea in proceso.Tareas)
                            {
                                <div class="d-flex justify-content-between align-items-center mb-2 task-item">

                                    <div>
                                        <input class="form-check-input me-2"
                                               type="checkbox"
                                               onchange="toggleTask(this)" />
                                        <span>
                                            @tarea.Nombre
                                        </span>
                                    </div>

                                    <button class="btn btn-sm btn-outline-secondary">
                                        Detalles
                                    </button>
                                </div>
                            }
                        </div>
                    }

                </div>
            </div>
        </div>

    </div>
</div>

<script>
    let selectedProjectId = null;

    const projectItems = document.querySelectorAll(".project-item");

    projectItems.forEach(item => {
        item.addEventListener("click", function () {

            projectItems.forEach(p => p.classList.remove("active"));
            this.classList.add("active");

            selectedProjectId = this.getAttribute("data-project-id");

            document.getElementById("readBtn").disabled = false;
            document.getElementById("editBtn").disabled = false;
            document.getElementById("deleteBtn").disabled = false;
        });
    });

    function toggleTask(checkbox) {
        const text = checkbox.nextElementSibling;

        if (checkbox.checked) {
            text.classList.add("task-completed");
        } else {
            text.classList.remove("task-completed");
        }
    }
</script>









