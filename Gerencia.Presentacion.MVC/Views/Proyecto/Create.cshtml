@model Gerencia.Presentacion.MVC.Models.ViewModels.Proyecto.ProyectoFormViewModel
@{
    ViewData["Title"] = "Crear Proyecto";
}

<h1>Crear Proyecto</h1>

<form asp-action="Create" method="post">
    @Html.AntiForgeryToken()

    <div class="mb-3">
        <label class="form-label">ID</label>
        <input class="form-control" value="(autonumérico)" disabled />
    </div>

    <partial name="_ProyectoFormBodyVM" model="Model" />

    <div class="mt-3 d-flex gap-2">
        <button type="submit" class="btn btn-primary">Guardar</button>
        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}