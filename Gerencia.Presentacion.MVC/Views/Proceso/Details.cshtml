@model Gerencia.Core.Dtos.ProcesoDto
@{
    ViewData["Title"] = "Detalle";
}
<h1>Detalle de Producto</h1>
<dl class="row">
    <dt class="col-sm-3">Línea</dt>
    <dd class="col-sm-9">@Model.ImportanciaId</dd>
    <dt class="col-sm-3">Tipo Medida</dt>
    <dd class="col-sm-9">@Model.EstadoId</dd>
    <dt class="col-sm-3">Status</dt>
</dl>
<p>
    <a class="btn btn-secondary" asp-action="Index">Volver</a>
    <a class="btn btn-warning" asp-action="Edit" asp-route-id="@Model.ProcesoId">Editar</a>
</p>