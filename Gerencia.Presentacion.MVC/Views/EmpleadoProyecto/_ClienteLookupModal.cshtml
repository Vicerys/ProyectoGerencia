@* Views/EmpleadoProyecto/_EmpleadoLookupModal.cshtml *@
<div class="modal fade" id="empleadoLookupModal"
     data-lookup-url="@Url.Action("Lookup", "Empleado")"
     tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Buscar Empleado</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>

            <div class="modal-body">
                <!-- Filtro -->
                <form class="row g-2" id="empleadoLookupForm" onsubmit="return false;">
                    <div class="col-12 col-md-9">
                        <label for="empleadoFiltroTerm" class="form-label">ID o parte del nombre</label>
                        <input class="form-control" id="empleadoFiltroTerm" placeholder="Ej. 123 o Juan Pérez" />
                    </div>
                    <div class="col-12 col-md-3 d-flex align-items-end">
                        <button type="button" class="btn btn-primary w-100" id="empleadoDoSearch">Buscar</button>
                    </div>
                </form>

                <!-- Resultados -->
                <div class="table-responsive mt-3">
                    <table class="table table-hover align-middle" id="empleadoResults">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Nombre</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @* Las filas se agregan por JS. Cada fila incluye un botón "Usar". *@
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

