@model Gerencia.Core.Dtos.EmpleadoProyectoDto
@{
    ViewData["Title"] = "Detalle de asignación";
    var lineas = Model.Detalles?.Count ?? 0;
    
}

<h1 class="mb-3">Detalle de Pedido</h1>

<div class="card">
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-3">
                <label class="form-label">ID de asignación</label>
                <input class="form-control" value="@Model.EmpleadoProyectoId" disabled />
            </div>
            <div class="col-md-3">
                <label class="form-label">ID de Empleado</label>
                <input class="form-control" value="@Model.EmpleadoId" disabled />
            </div>
            <div class="col-md-6">
                <label class="form-label">Nombre del Empleado</label>
                <input class="form-control" value="@(Model.Empleado?.Nombre ?? "")" disabled />
            </div>

            <div class="col-md-3">
                <label class="form-label">Fecha de asignación</label>
                <input class="form-control" value="@Model.FechaAsignacion.ToString("yyyy-MM-dd")" disabled />
            </div>
            <div class="col-md-3">
                <label class="form-label">Cantidad de Líneas</label>
                <input class="form-control" value="@lineas" disabled />
            </div>
            
        </div>
    </div>
</div>

<div class="mt-3 d-flex gap-2">
    <a asp-action="Edit" asp-route-id="@Model.EmpleadoProyectoId" class="btn btn-primary">Editar</a>
    <a asp-action="Delete" asp-route-id="@Model.EmpleadoProyectoId" class="btn btn-outline-danger">Borrar</a>
    <a asp-action="Index" class="btn btn-secondary">Regresar</a>
</div>
