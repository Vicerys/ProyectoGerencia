@model Gerencia.Presentacion.MVC.Models.ViewModels.EmpleadoProyecto.EmpleadoProyectoFormViewModel
@{
    ViewData["Title"] = "Crear Pedido";
}

<h1>Crear Pedido</h1>

<form asp-action="Create" method="post" id="empleadoProyectoForm">
    @Html.AntiForgeryToken()

    <div class="row g-3">
        <div class="col-md-3">
            <label class="form-label">ID de Asignación</label>
            <input class="form-control" value="(autonumérico)" disabled />
        </div>
        <div class="col-md-3">
            <label asp-for="EmpleadoProyecto.EmpleadoProyectoId" class="form-label"></label>
            <div class="input-group">
                <input asp-for="EmpleadoProyecto.EmpleadoProyectoId" class="form-control" id="clienteIdInput" />
                <button type="button" class="btn btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#clienteLookupModal">Buscar…</button>
            </div>
        </div>
        <div class="col-md-3">
            <label asp-for="EmpleadoProyecto.FechaAsignacion" class="form-label"></label>
            <input asp-for="EmpleadoProyecto.FechaAsignacion" type="date" class="form-control" />
        </div>
    </div>

    <hr />

    <partial name="_EmpleadoProyectoDetalleTable" model="Model" />

    <div class="mt-4 d-flex gap-2">
        <button type="submit" class="btn btn-primary">Guardar</button>
        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
    </div>
</form>

<partial name="_EmpleadoLookupModal" />
<partial name="_ProyectoLookupModal" />

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/EmpleadoProyecto.js" asp-append-version="true"></script>
}