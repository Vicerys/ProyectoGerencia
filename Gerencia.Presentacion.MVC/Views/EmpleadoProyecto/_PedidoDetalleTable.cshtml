@model Gerencia.Presentacion.MVC.Models.ViewModels.EmpleadoProyecto.EmpleadoProyectoFormViewModel

<div class="d-flex justify-content-between align-items-center">
    <h5 class="m-0">Líneas</h5>
    <button type="button" class="btn btn-sm btn-success" data-bs-toggle="modal" data-bs-target="#proyectoLookupModal">Agregar línea</button>
</div>

<table class="table table-sm align-middle mt-2" id="detTable">
    <thead>
        <tr>
            <th>#</th>
            <th>ID Proyecto</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @for (int i = 0; i < (Model.Detalles?.Count ?? 0); i++)
        {
            var det = Model.Detalles?[i];
            <tr data-persisted="true"
                data-pedido-id="@Model.EmpleadoProyecto.EmpleadoProyectoId"
                data-linea="@det?.Linea">
                <td class="row-index">@(i + 1)</td>
                <td><input class="form-control form-control-sm" name="Detalles[@i].ProyectoID" value="@det?.ProyectoID" /></td>
				
                <td>
                    <button type="button" class="btn btn-sm btn-outline-danger del-line" title="Eliminar">✕</button>
                </td>
            </tr>
        }
    </tbody>
