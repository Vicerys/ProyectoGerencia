</table>

<!-- plantilla oculta para nuevas líneas -->
<table class="d-none">
    <tbody id="detRowTpl">
        <tr>
            <td class="row-index"></td>
            <td><input class="form-control form-control-sm" name="__IDX__.cID" /></td>
            <td><button type="button" class="btn btn-sm btn-outline-danger del-line">✕</button></td>
        </tr>
